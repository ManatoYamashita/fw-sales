{
  "name": "fw-sales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-required-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:setup": "node --env-file-if-exists=.env.e2e scripts/e2e-setup.mjs",
    "e2e:server": "node --env-file-if-exists=.env.e2e scripts/e2e-server.mjs",
    "e2e": "pnpm e2e:setup && node --env-file-if-exists=.env.e2e ./node_modules/@playwright/test/cli.js test",
    "e2e:ui": "pnpm e2e:setup && node --env-file-if-exists=.env.e2e ./node_modules/@playwright/test/cli.js test --ui",
    "e2e:install": "playwright install chromium",
    "seed": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed.ts",
    "db:backfill-basic-info": "NODE_OPTIONS='--conditions=react-server' tsx scripts/backfill-basic-info.ts",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:check": "bash scripts/check-drizzle-migrations.sh",
    "db:verify-fks": "node --env-file-if-exists=.env.local scripts/verify-store-cascade-fks.mjs",
    "db:verify-hashes": "node --env-file-if-exists=.env.local scripts/verify-migration-hashes.mjs",
    "db:set-role": "node --env-file-if-exists=.env.local scripts/set-profile-role.mjs",
    "db:diagnose-area-search": "node --env-file-if-exists=.env.local scripts/diagnose-area-search-plan.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^1.52.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.12.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workflow": "5.0.0-beta.38",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/oxide": "4.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
