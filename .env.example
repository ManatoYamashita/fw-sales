# ============================================================================
# Firstweb Lead OS - 環境変数テンプレート
# ----------------------------------------------------------------------------
# このファイルをコピーして `.env.local` を作成し、各値を実環境に合わせて
# 設定してください。`.env.local` は git 管理対象外です。
#
#   cp .env.example .env.local
#
# 値はすべてダミー (プレースホルダー) です。実際の認証情報は記載しません。
# ============================================================================


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL  (本番デプロイ時 推奨)
# ----------------------------------------------------------------------------
# 用途   : OGP / Twitter Card / canonical / manifest など、絶対 URL が要求される
#          メタデータの解決に使用される `metadataBase` の値 (app/layout.tsx)。
# 形式   : スキーム付き URL (例: https://lead-os.example.com)
#          - 末尾スラッシュは付けない (Next.js の URL 合成側が正規化する)
#          - Slack / Microsoft Teams / X で OGP プレビューを表示するには
#            アクセス可能な公開 URL であることが望ましい (社内 IP / VPN 配下は不可)
# 推奨値 : 本番ドメイン (例: https://lead-os.example.com)
# 注意   : 未設定時は `http://localhost:3000` にフォールバックする (開発時の便宜)。
#          本番で未設定のままだと OGP の `og:image` が `http://localhost:3000/ogp.webp`
#          として解決され、外部 SNS でプレビュー画像が表示されなくなる。
#          NEXT_PUBLIC_ プレフィックスのためクライアントバンドルにも露出する点に注意
#          (本値は公開情報なので問題なし)。
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# DATABASE_URL  (DB モード時 必須)
# ----------------------------------------------------------------------------
# 用途   : Supabase Postgres への接続文字列。Drizzle + postgres.js が参照する。
# 形式   : postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#          - Supabase の場合、Project Settings > Database > Connection string
#            の "Transaction Pooler" (port 6543) を推奨。
#          - postgres.js は Transaction Pooler 互換のため `prepare: false` を
#            既定で設定済み (lib/db/client.ts)。
# 推奨値 : Supabase の Transaction Pooler 接続文字列をそのまま貼り付ける。
# 注意   : `USE_MOCK_DB=true` の場合は読み取られないため未設定でも起動可能。
#          DB モードで起動する場合は欠落していると起動が中断する (Req 6.1)。
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@db.your-project-ref.supabase.co:6543/postgres?sslmode=require


# ----------------------------------------------------------------------------
# USE_MOCK_DB  (任意)
# ----------------------------------------------------------------------------
# 用途   : 永続化レイヤを Mock (インメモリ) と DB (Supabase) のどちらに
#          バインドするかを起動時に決定するスイッチ。
# 形式   : "true" | 未設定 | その他文字列
#          - "true"          : Mock モード (DB 接続なしで動作)
#          - 未設定 or その他: DB モード (DATABASE_URL 必須)
# 推奨値 : ローカル開発・E2E で DB を使わない場合は `true`。
#          ステージング / 本番では未設定 (= DB モード) とする。
# 注意   : リクエスト処理中の動的切替はサポート外。プロセス再起動が必要。
# ----------------------------------------------------------------------------
# USE_MOCK_DB=true


# ----------------------------------------------------------------------------
# DATABASE_POOL_MAX  (任意)
# ----------------------------------------------------------------------------
# 用途   : postgres.js のコネクションプール最大数 (lib/db/client.ts の `max`)。
# 形式   : 正の整数 (文字列表現でも可)
# 推奨値 : 配備形態に応じて使い分けること。
#          - Self-host (Node 長期プロセス, Docker, VPS 等) : 10
#          - Vercel / serverless / Edge-adjacent          : 1
#            (各実行環境で 1 接続に絞り、Supabase Pooler 側で多重化)
# 注意   : 未設定時の既定値は "10" (lib/db/client.ts のフォールバック)。
#          Vercel 配備で既定値のままだと Pooler の上限を消費し
#          "too many connections" を誘発するため、必ず "1" に上書きする。
# ----------------------------------------------------------------------------
# DATABASE_POOL_MAX=10


# ----------------------------------------------------------------------------
# GEMINI_API_KEY  (AI 分析モード時 必須)
# ----------------------------------------------------------------------------
# 用途   : Google Gemini API への認証キー。`/stores/new` の [AI で分析] ボタンが
#          呼び出す Server Action (lib/actions/ai-analysis-actions.ts) が使用する。
# 形式   : Google AI Studio で発行した API Key 文字列 ("AIzaSy..." で始まる)
# 推奨値 : Google AI Studio (https://aistudio.google.com/apikey) で発行し、
#          `.env.local` のみに記載 (この .env.example には書かない)。
# 注意   : 未設定時は AI 分析機能のみ無効化される (ボタンが disabled 表示) が
#          サービス全体は通常通り稼働する (Req 2.7)。
#          Server Action でのみ参照され、クライアントへ漏洩しないよう
#          `import "server-only"` で隔離されたモジュール経由で読出す。
# ----------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy_your_api_key_here


# ----------------------------------------------------------------------------
# GEMINI_MODEL  (任意)
# ----------------------------------------------------------------------------
# 用途   : AI 分析で使用する Gemini モデル名を指定する。
# 形式   : Google GenAI SDK が認識するモデル ID 文字列
# 推奨値 : "gemini-2.5-flash" (デフォルト、コスト・レイテンシ・品質のバランス最良)
#          "gemini-2.5-pro"   (Flash で品質不足時のフォールバック、約 4 倍コスト)
# 注意   : 未設定時の既定値は "gemini-2.5-flash"。
#          モデル変更はコードの修正なしに環境変数だけで切替可能。
# ----------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash


# ============================================================================
# Authentication & Notifications (auth-and-notifications spec, Issue #16)
# ----------------------------------------------------------------------------
# 以下は Supabase Auth (Google OAuth) と Resend ベースのメール通知基盤、
# Vercel Cron 経由の商談リマインダー配信に必要な環境変数。
# ============================================================================


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL  (認証モード時 必須)
# ----------------------------------------------------------------------------
# 用途   : Supabase プロジェクトの API エンドポイント URL。
#          @supabase/ssr のサーバ・クライアント・ミドルウェア各クライアントが参照する。
# 形式   : https://<project-ref>.supabase.co
# 推奨値 : Supabase Dashboard > Project Settings > API > Project URL の値。
# 注意   : 未設定時は認証関連経路 (middleware / /login / /auth/callback) が
#          warn ログを出しサインイン処理は失敗する (Req 8.2)。
#          USE_MOCK_DB=true の場合はバイパスされる (固定 mock profile で動作)。
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY  (認証モード時 必須)
# ----------------------------------------------------------------------------
# 用途   : Supabase の Anon (public) API Key。クライアント / サーバ両方で
#          セッション取得・OAuth 起動に使用する。
# 形式   : JWT 形式の API Key 文字列 ("eyJ..." で始まる長文字列)
# 推奨値 : Supabase Dashboard > Project Settings > API > Project API keys >
#          "anon public" の値。
# 注意   : NEXT_PUBLIC_ プレフィックスのためクライアントバンドルにも露出するが、
#          Anon Key は公開前提のキーなので問題なし (RLS で保護される想定)。
#          未設定時の挙動は NEXT_PUBLIC_SUPABASE_URL と同様。
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here


# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY  (Server-only、サービスロール処理時のみ必須)
# ----------------------------------------------------------------------------
# 用途   : RLS をバイパスする管理者権限キー。Server Action / Cron / バックフィル
#          スクリプトなど、Server-only モジュールからのみ参照する。
# 形式   : JWT 形式の Service Role Key 文字列 ("eyJ..." で始まる長文字列)
# 推奨値 : Supabase Dashboard > Project Settings > API > Project API keys >
#          "service_role" の値。
# 注意   : NEXT_PUBLIC_ プレフィックスを付けない (クライアントへ露出禁止)。
#          露出するとデータベース全体への管理アクセス権が漏洩する。
#          未設定時は通常のアプリ動作には影響しないが、バックフィルや
#          管理者処理で警告ログが出る。
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID  (Google OAuth プロバイダ設定時 必須)
# ----------------------------------------------------------------------------
# 用途   : Google Cloud Console で発行した OAuth 2.0 クライアント ID。
#          Supabase Dashboard の Auth > Providers > Google に登録する値。
# 形式   : "*.apps.googleusercontent.com" 形式の文字列
# 推奨値 : Google Cloud Console > APIs & Services > Credentials >
#          OAuth 2.0 Client ID > Web Application の値。
# 注意   : 値そのものはアプリ側でランタイム参照しない (Supabase 側の設定)。
#          このファイルには参照用として記載し、運用ドキュメントの一部として残す。
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# ----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_SECRET  (Google OAuth プロバイダ設定時 必須)
# ----------------------------------------------------------------------------
# 用途   : Google OAuth クライアントシークレット。Supabase Dashboard 側に登録する。
# 形式   : Google Cloud Console で発行されるシークレット文字列
# 推奨値 : Google Cloud Console > APIs & Services > Credentials >
#          OAuth 2.0 Client ID > Web Application の "Client Secret" の値。
# 注意   : 値そのものはアプリ側でランタイム参照しない (Supabase 側の設定)。
#          GitHub などにコミットしないこと (.env.local のみに記載)。
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret


# ----------------------------------------------------------------------------
# RESEND_API_KEY  (メール送信を有効化する場合)
# ----------------------------------------------------------------------------
# 用途   : Resend SDK が SMTP API を呼び出す際の認証キー。
#          ジョブ完了通知 / 商談リマインダーメールの送信に使用される。
# 形式   : "re_" で始まる API Key 文字列
# 推奨値 : Resend Dashboard > API Keys で発行した値。
# 注意   : 未設定時は emailClient.send() が no-op を返し warn ログを出すのみ。
#          認証 / 主要機能 / Cron は通常通り稼働する (Req 4.2, 8.3)。
#          開発環境では未設定で運用するのが推奨 (誤配信防止)。
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key_here


# ----------------------------------------------------------------------------
# RESEND_FROM_EMAIL  (RESEND_API_KEY 設定時 必須)
# ----------------------------------------------------------------------------
# 用途   : 全送信メールの From アドレス。Resend で送信元ドメインの SPF/DKIM/DMARC
#          検証が完了している必要がある。
# 形式   : "fw-sales <noreply@yourdomain.com>" のような RFC 5322 形式
# 推奨値 : 自社ドメインで Resend 検証済の noreply 系アドレス。
# 注意   : 未設定時は emailClient.send() が no-op を返す (RESEND_API_KEY 同様)。
#          From ドメインが Resend で未検証だと送信エラーになるため事前検証必須。
# ----------------------------------------------------------------------------
# RESEND_FROM_EMAIL=fw-sales <noreply@your-domain.example>


# ----------------------------------------------------------------------------
# CRON_SECRET  (Vercel Cron デプロイ時 必須)
# ----------------------------------------------------------------------------
# 用途   : Vercel Cron から /api/cron/deal-reminders 等の Route Handler が
#          呼び出される際の Bearer 認可トークン。
# 形式   : 任意の高エントロピー文字列 (例: openssl rand -hex 32 の出力)
# 推奨値 : 32 文字以上のランダム文字列を Vercel 側 Environment Variables に設定。
# 注意   : Authorization ヘッダ "Bearer ${CRON_SECRET}" との一致を Route Handler が
#          検証する。不一致時は 401 で拒否 (Req 6.x の Cron 認可)。
#          ローカル開発時は curl の Authorization ヘッダで疑似発火させる。
# ----------------------------------------------------------------------------
# CRON_SECRET=your_high_entropy_random_string
