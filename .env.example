# 主にmetadata用
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres Drizzle 用
DATABASE_URL=postgres://USER:PASSWORD@db.your-project-ref.supabase.co:6543/postgres?sslmode=require

# Mock dataを使用するかどうかのフラグ。開発時はtrue
# USE_MOCK_DB=true

# postgres.js のコネクションプール最大数 (lib/db/client.ts の `max`)。
# 未設定時の既定値は "10" (lib/db/client.ts のフォールバック)。
# DATABASE_POOL_MAX=10

# Gemini API Key
GEMINI_API_KEY=AIzaSy_your_api_key_here

# Gemini APIモデル
GEMINI_MODEL=gemini-2.5-flash


# ----------------------------------------------------------------------------
# GEMINI_MODEL  (任意)
# ----------------------------------------------------------------------------
# 用途   : AI 分析で使用する Gemini モデル名を指定する。
# 形式   : Google GenAI SDK が認識するモデル ID 文字列
# 推奨値 : "gemini-2.5-flash" (デフォルト、コスト・レイテンシ・品質のバランス最良)
#          "gemini-2.5-pro"   (Flash で品質不足時のフォールバック、約 4 倍コスト)
# 注意   : 未設定時の既定値は "gemini-2.5-flash"。
#          モデル変更はコードの修正なしに環境変数だけで切替可能。
# ----------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash


# ----------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY  (エリア検索機能 必須)
# ----------------------------------------------------------------------------
# 用途   : Google Places API New (v2) への認証キー。`/stores/search` のエリア検索機能
#          (`lib/places/google.ts`) が参照する。
# 形式   : Google Cloud Console で発行した API Key 文字列
# 前提   : Cloud Console で "Places API (New)" を有効化しておくこと。
#          旧 "Places API" とは別サービスのため、個別に有効化が必要。
# 推奨値 : Google Cloud Console (https://console.cloud.google.com/) で発行し、
#          `.env.local` のみに記載 (この .env.example には書かない)。
# 注意   : 未設定時はエリア検索の Server Action がエラーを返す。
#          他の機能 (通常登録・AI 分析・ダッシュボード) への影響はない。
#          Server Action でのみ参照され、クライアントへ漏洩しないよう
#          `import "server-only"` で隔離されたモジュール経由で読み出す。
# ----------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=AIzaSy_your_places_api_key_here


# ----------------------------------------------------------------------------
# HOTPEPPER_API_KEY  (任意 / 将来対応)
# ----------------------------------------------------------------------------
# 用途   : ホットペッパーグルメ API への認証キー。エリア検索での欠損項目補完
#          (電話番号・営業時間・ジャンル等) で使用予定 (現時点では未実装)。
# 形式   : リクルート Web サービスで発行した API Key 文字列
# 注意   : 現時点では参照されません。将来の機能追加時に有効化します。
# ----------------------------------------------------------------------------
# HOTPEPPER_API_KEY=


# ----------------------------------------------------------------------------
# GURUNAVI_API_KEY  (任意 / 将来対応)
# ----------------------------------------------------------------------------
# 用途   : ぐるなび API への認証キー。エリア検索での欠損項目補完で
#          使用予定 (現時点では未実装)。
# 形式   : ぐるなび for Developers で発行した API Key 文字列
# 注意   : 現時点では参照されません。将来の機能追加時に有効化します。
# ----------------------------------------------------------------------------
# GURUNAVI_API_KEY=


# ============================================================================
# Authentication & Notifications (auth-and-notifications spec, Issue #16)
# ----------------------------------------------------------------------------
# 以下は Supabase Auth (Google OAuth) と Resend ベースのメール通知基盤、
# Vercel Cron 経由の商談リマインダー配信に必要な環境変数。
# ============================================================================


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL  (認証モード時 必須)
# ----------------------------------------------------------------------------
# 用途   : Supabase プロジェクトの API エンドポイント URL。
#          @supabase/ssr のサーバ・クライアント・ミドルウェア各クライアントが参照する。
# 形式   : https://<project-ref>.supabase.co
# 推奨値 : Supabase Dashboard > Project Settings > API > Project URL の値。
# 注意   : 未設定時は認証関連経路 (middleware / /login / /auth/callback) が
#          warn ログを出しサインイン処理は失敗する (Req 8.2)。
#          USE_MOCK_DB=true の場合はバイパスされる (固定 mock profile で動作)。
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here


# Supabase Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# Google OAuth Client Secret
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret


# Resend API Key
# RESEND_API_KEY=re_your_resend_api_key_here


# Resend From Email
# RESEND_FROM_EMAIL=fw-sales <noreply@your-domain.example>

# Cron Secret
# CRON_SECRET=your_high_entropy_random_string
