# アプリの公開URL（例）
NEXT_PUBLIC_APP_URL=https://fw-sales.example.com

# Supabase (Auth + Postgres 共通)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (Supabase Auth Provider 設定値)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Google Places API Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google Maps JavaScript API Key (エリア検索の地図表示用。クライアントに公開されるキー)
# 未設定の場合、地図は表示されず一覧検索のみ利用可能。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key

# Gemini
GEMINI_API_KEY=your_gemini_api_key
# 営業資産生成のモデル。未設定時のコード既定は gemini-3.6-flash (GA)。
# 旧既定 gemini-2.5-flash は deprecated (シャットダウン 2026-10-16) のため指定しないこと。
# 品質/コスト/レイテンシの切り戻し先は gemini-3.5-flash か gemini-3.5-flash-lite (いずれも GA)。
# 詳細: docs/gemini-model-migration-runbook.md
GEMINI_MODEL=gemini-3.6-flash

# --- AI 店舗調査 (任意の override。未設定でコード側の既定値が使われる) ---

# AI 店舗調査で使う Gemini モデル。未設定時は GEMINI_MODEL の値を継承する
# (コード既定も同じ gemini-3.6-flash)。営業資産生成と切り戻し経路を分けるための
# override で、tools (Google Search / URL Context) を使う調査フローだけを
# 個別にロールバックしたい場合に指定する。
# 切り戻し先の選び方は GEMINI_MODEL と同じ (docs/gemini-model-migration-runbook.md)。
# RESEARCH_GEMINI_MODEL=gemini-3.6-flash

# Stage2 の1回の生成で許す出力トークン上限。コード既定は 24576。
# Gemini 3系は thinking token もこの枠を消費するため、8192 では JSON が
# 打ち切られ Stage2 全体が失敗する事象を実機で確認済み。
#
# **16384 へ下げないこと。** 本番の成功 run 33 件の実測 (2026-08-16 時点) では
# thoughts + candidates が 最大 21,927 / p95 20,300 / 平均 14,921 token で、
# 最大値は 16384 の 133.8% に達する (24576 に対しては 89.2%)。
# 16384 では最悪ケースが確実に打ち切られる (fatal:max_tokens を実際に1件記録済み)。
# 24576 でもヘッドルームは1割程度しかないため、下げるより上げる方が安全側。
# 上限は gemini-3.6-flash の 65536 だが、Stage2 の step timeout (240秒) に
# 収まる必要があるため無制限には上げられない。
# 不正値 (非数値・0・負) は既定へフォールバックする。
# RESEARCH_MAX_OUTPUT_TOKENS=24576

# stuck run 判定に使う expires_at のマージン(分)。
# コード既定は Workflow の timeout / retry 構成から導出した安全下限
# (lib/ai/research/run-timing.ts の MIN_SAFE_EXPIRES_MARGIN_MINUTES)。
# これは「安全側へ延長する」ための override であり、
# **安全下限未満を指定しても下限へ clamp される**(警告ログを出力)。
# 短すぎる値は、正常に処理中の run を stuck と誤判定して二重 run を招くため。
# 不正値 (非数値・0・負) は既定へフォールバックする。
# RESEARCH_RUN_EXPIRES_MARGIN_MINUTES=30

# Database (Supabase Postgres - Transaction Pooler 推奨: port 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10
