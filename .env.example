# 主にmetadata用
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres Drizzle 用
DATABASE_URL=postgres://USER:PASSWORD@db.your-project-ref.supabase.co:6543/postgres?sslmode=require

# Mock dataを使用するかどうかのフラグ。開発時はtrue
# USE_MOCK_DB=true

# postgres.js のコネクションプール最大数 (lib/db/client.ts の `max`)。
# 未設定時の既定値は "10" (lib/db/client.ts のフォールバック)。
# DATABASE_POOL_MAX=10

# Gemini API Key
GEMINI_API_KEY=AIzaSy_your_api_key_here

# Gemini APIモデル
GEMINI_MODEL=gemini-2.5-flash

# Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here


# Supabase Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# Google OAuth Client Secret
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret


# Resend API Key
# RESEND_API_KEY=re_your_resend_api_key_here


# Resend From Email
# RESEND_FROM_EMAIL=fw-sales <noreply@your-domain.example>

# Cron Secret
# CRON_SECRET=your_high_entropy_random_string
